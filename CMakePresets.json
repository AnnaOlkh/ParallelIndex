{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "mingw-release",
      "displayName": "Windows MSYS2 UCRT64 — Release",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/mingw32-make.exe",
        "ENABLE_UNSAFE_V1": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "mingw-unsafe",
      "displayName": "Windows MSYS2 UCRT64 — explicit unsafe V1 experiment",
      "inherits": "mingw-release",
      "binaryDir": "${sourceDir}/build-unsafe",
      "cacheVariables": { "ENABLE_UNSAFE_V1": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "mingw-release", "configurePreset": "mingw-release", "jobs": 4 },
    { "name": "mingw-unsafe", "configurePreset": "mingw-unsafe", "jobs": 4 }
  ],
  "testPresets": [
    { "name": "mingw-release", "configurePreset": "mingw-release", "output": { "outputOnFailure": true } },
    { "name": "mingw-unsafe", "configurePreset": "mingw-unsafe", "output": { "outputOnFailure": true } }
  ]
}
